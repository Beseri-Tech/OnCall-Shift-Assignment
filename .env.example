# Copy to .env and fill in. Never commit .env.

# Database password (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# First admin (a supervisor account), created on first start while no admin exists.
# Generate the password hash with:
#   docker build -t oncall-rota . && docker run --rm -it oncall-rota hash-password
# Keep the SINGLE QUOTES - the hash contains '$' characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH='pbkdf2-sha256$210000$...$...'

# Address people use to reach the app; used for links in emails.
APP_BASE_URL=https://rota.example.com
# Only when the web app is hosted separately (e.g. Cloudflare Pages): its address, allowed to call the API.
# Must share the API's domain (rota.example.com + rota-api.example.com) or the sign-in cookie isn't sent.
WEB_ORIGIN=

# Email for invites and password resets (e.g. Gmail with an app password: smtp.gmail.com, 587).
# Leave SMTP_HOST empty to skip email: invites then show the temporary password to the admin instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional
APP_PORT=8080
# Image tag from ghcr.io (latest = newest master; or a release like 1.2.3)
APP_TAG=latest
DB_PORT=5432
TIME_ZONE=Asia/Kuala_Lumpur
