# Copy to .env and fill in. Never commit .env.

# Database password (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# First master account (sees every hospital), created on first start while no master exists.
# Generate the password hash with:
#   docker build -t rota-oc . && docker run --rm -it rota-oc hash-password
# Keep the SINGLE QUOTES - the hash contains '$' characters.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH='pbkdf2-sha256$210000$...$...'

# Address people use to reach the app; used for links in emails.
APP_BASE_URL=https://rota.example.com
# Only when the web app is hosted separately (e.g. Cloudflare Pages): its address, allowed to call the API.
# Must share the API's domain (rota.example.com + rota-api.example.com) or the sign-in cookie isn't sent.
WEB_ORIGIN=

# Email for invites and password resets (e.g. Gmail with an app password: smtp.gmail.com, 587).
# Leave SMTP_HOST empty to skip email: invites then show the temporary password to the admin instead.
SMTP_HOST=
# Whether email starts switched on (true) or off (false, e.g. staging). Masters can flip it in the app; their choice is kept.
SMTP_ENABLED=true
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender: a name ("Rota System", sent from SMTP_USER), an address, or both ("Rota System <you@gmail.com>").
# Gmail only sends as the signed-in account, so keep the address the same as SMTP_USER. Empty = SMTP_USER.
SMTP_FROM=

# Cloudflare R2 private bucket for the user manual and uploaded documents (see README). Leave empty to switch document storage off.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nightly database backup to a SEPARATE private R2 bucket with its own token (see README). Leave empty to switch it off.
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET_NAME=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Folder inside the bucket: production here, staging on the staging server.
BACKUP_PREFIX=production
# Optional: hour of the night (0-23, clinic time) to back up; set BACKUP_RUN_ON_STARTUP=true for one test run a minute after start.
# BACKUP_HOUR=3
# BACKUP_RUN_ON_STARTUP=false
# Optional: a healthchecks-style URL that is called after each successful backup, so you hear when backups stop.
# BACKUP_PING_URL=

# Optional
APP_PORT=8080
# Image tag from ghcr.io (latest = newest master, staging = newest staging; or a release like 1.2.3)
APP_TAG=latest
DB_PORT=5432
TIME_ZONE=Asia/Kuala_Lumpur
